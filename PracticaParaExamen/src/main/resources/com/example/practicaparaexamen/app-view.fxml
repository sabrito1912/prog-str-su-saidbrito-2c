<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.practicaparaexamen.controllers.ContactoController">

    <children>
        <Label text="Registro de contactos de emergencia" />

        <GridPane>
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            </rowConstraints>
            <children>
                <Label text="Nombre" />
                <Label text="Teléfono" GridPane.rowIndex="1" />
                <Label text="Parentesco" GridPane.rowIndex="2" />

                <TextField fx:id="txtNombre" GridPane.columnIndex="1" />
                <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbParentesco" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <HBox prefHeight="30.0" prefWidth="200.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onAgregar" text="Agregar" />
                <Button mnemonicParsing="false" onAction="#onBuscar" text="Buscar" />
                <Button mnemonicParsing="false" onAction="#onActualizar" text="Actualizar" />
                <Button mnemonicParsing="false" onAction="#onEliminar" text="Eliminar" />
                <Button mnemonicParsing="false" onAction="#onLimpiar" text="Limpiar" />
            </children>
        </HBox>

        <ListView fx:id="listViewContactos" prefHeight="200.0" prefWidth="200.0" />

        <Label fx:id="lblMensaje" />
    </children>

</VBox>